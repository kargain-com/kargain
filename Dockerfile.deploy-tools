# Deploy tooling only (plan / state / retention / readiness probe CLIs).
# ADR 0009 pinned Node; not a writer image. Built on every deploy run (cached).
FROM node:24.22.1-alpine
WORKDIR /app
# tsx only — tooling CLIs import Node builtins + these scripts.
RUN npm init -y >/dev/null && npm install --omit=dev tsx@4.21.0
COPY scripts/ponder-deploy-plan-cli.ts \
     scripts/ponder-deploy-state-cli.ts \
     scripts/ponder-deploy-retention-cli.ts \
     scripts/ponder-ready-probe.ts \
     scripts/ponder-probe-observation-cli.ts \
     ./scripts/
COPY scripts/lib/ponder-deploy-plan.ts \
     scripts/lib/ponder-deploy-state.ts \
     scripts/lib/ponder-deploy-retention.ts \
     scripts/lib/ponder-readiness-probe.ts \
     scripts/lib/ponder-probe-observation.ts \
     ./scripts/lib/
# Container entrypoint is the only Node binary the executor invokes (no host node).
ENTRYPOINT ["node", "--import", "tsx"]
