{
  "compilerOptions": {
    "target": "ES2022",
    // Node / tsx / Hardhat ops — no browser libs. Scripts must not rely on
    // window / IndexedDB / JSX types; those belong to the test project.
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    // bundler + allowImportingTsExtensions: files run under tsx/Hardhat and
    // import with explicit .ts suffixes; NodeNext would force .js rewrites
    // (behaviour-adjacent) without matching how they load.
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "adapters/**/*.ts",
    "hardhat.config.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "svm",
    "test"
  ]
}
