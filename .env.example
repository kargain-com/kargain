# =============================================================================
# Kargain environment variables
#
# Copy to `.env.local` for Next.js (`pnpm dev` / `pnpm build`).
# Hardhat reads `.env` / `.env.local` via hardhat.config.ts (dotenv).
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Public origin of the Next.js app (SIWE domain, metadata, redirects).
# Used by: lib/config/app-url.ts, lib/auth/siwe-session.ts
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional production override for SIWE session signing.
# If unset, a dev fallback derived from NEXT_PUBLIC_APP_URL is used.
# Used by: lib/auth/siwe-session.ts
# SIWE_SESSION_SECRET=

# -----------------------------------------------------------------------------
# Arweave / Irys (passport photos + metadata)
# -----------------------------------------------------------------------------

# Passport upload is client-side only — user wallet pays via @irys/web-upload.
# No IRYS_NODE_URL or server private key required for mint/edit.
# Bundler URL is chosen from the connected wallet chain ID (see lib/storage/irys-client.ts).
# Optional override for HTTP display of ar:// URIs:
# NEXT_PUBLIC_ARWEAVE_GATEWAY=https://gateway.irys.xyz

# -----------------------------------------------------------------------------
# Wallet / chains
# -----------------------------------------------------------------------------

# Default chain ID shown in the UI (Base Sepolia = 84532; local Hardhat = 31337).
# Used by: lib/web3/supported-chains.ts
NEXT_PUBLIC_CHAIN_ID=84532

# Set to 1 to expose Hardhat localhost (31337) in wagmi chain list.
# Used by: lib/web3/supported-chains.ts
# NEXT_PUBLIC_ENABLE_LOCAL_CHAIN=1

# JSON map of chain ID → public RPC URL for wagmi/viem reads.
# Example: {"84532":"https://sepolia.base.org","11155111":"https://ethereum-sepolia-rpc.publicnode.com","31337":"http://127.0.0.1:8545"}
# Used by: lib/web3/supported-chains.ts
NEXT_PUBLIC_RPC_BY_CHAIN={"84532":"https://sepolia.base.org","11155111":"https://ethereum-sepolia-rpc.publicnode.com"}

# Per-chain RPC override (alternative to NEXT_PUBLIC_RPC_BY_CHAIN).
# Example: NEXT_PUBLIC_RPC_84532=https://sepolia.base.org
# Used by: lib/web3/supported-chains.ts

# WalletConnect Cloud project ID (https://cloud.walletconnect.com).
# Required for mobile wallet connection outside a wallet in-app browser.
# Used by: lib/web3/wagmi-config.ts
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# -----------------------------------------------------------------------------
# XMTP (encrypted messaging)
# -----------------------------------------------------------------------------

# XMTP environment: dev | production | testnet | mainnet
# See https://docs.xmtp.org
# Used by: lib/xmtp/client.ts
# Dev network is periodically wiped by XMTP (identities included); use dev only for throwaway local testing.
NEXT_PUBLIC_XMTP_ENV=production

# -----------------------------------------------------------------------------
# Hardhat (compile, test, future deploy)
# -----------------------------------------------------------------------------

# Base Sepolia RPC for the hardhat `baseSepolia` network.
# Used by: hardhat.config.ts
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Ethereum Sepolia RPC for the hardhat `ethereumSepolia` network (spoke ONFT).
# Used by: hardhat.config.ts
ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer wallet private key for Hardhat networks (never commit a real key).
# Used by: hardhat.config.ts (baseSepolia + ethereumSepolia — localhost uses Hardhat node default accounts)
# DEPLOYER_PRIVATE_KEY=

# Verifier wallet private key for signing Vincent Commons epoch confirmations
# (pnpm vincent:confirm — never logged, never commit a real key).
# VINCENT_CONFIRMER_PRIVATE_KEY=

# Basescan / Etherscan API key for contract verification on Base Sepolia.
# Used by: hardhat.config.ts verify.etherscan, pnpm verify:sepolia
# Flags: --auction-only (impl+proxy only); --strict (exit 1 on HHE80009 bytecode mismatch)
ETHERSCAN_API_KEY=

# --- Deployed contracts (Base Sepolia, chain 84532) ---
# Resolution order: NEXT_PUBLIC_*_BY_CHAIN → single NEXT_PUBLIC_* (if truthy) → hardcoded Sepolia in deployment-addresses.ts
# Used by: lib/web3/deployment-addresses.ts
# FX rate detail: docs/REFERENCE.md §15 (local) — Chainlink feeds below; UI also uses CoinGecko when Chainlink returns null.
NEXT_PUBLIC_KAR_PASSPORT_ADDRESS=
NEXT_PUBLIC_KAR_PRO_PASS_ADDRESS=
NEXT_PUBLIC_KAR_PRO_STAKING_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
# Chainlink aggregator proxies (8 decimals). Empty on 84532 → hardcoded fallback in lib/web3/deployment-addresses.ts.
# Do NOT set to 0x0000000000000000000000000000000000000000 — overrides fallback and skips feed reads.
# Base Sepolia (June 2026): ETH/USD 0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1 (live)
#                           EUR/USD 0xb49f677943BC038e9857d61E7d053CaA2C1734C1 (dead — no contract; CoinGecko fills UI gap)
NEXT_PUBLIC_NATIVE_FEED_ADDRESS=
NEXT_PUBLIC_EUR_FEED_ADDRESS=
# NEXT_PUBLIC_NATIVE_FEED_BY_CHAIN={"84532":"0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1","8453":"0x…"}
# NEXT_PUBLIC_EUR_FEED_BY_CHAIN={"84532":"0xb49f677943BC038e9857d61E7d053CaA2C1734C1","8453":"0x…"}
# NEXT_PUBLIC_KAR_PASSPORT_BY_CHAIN={"31337":"0x…","84532":"0x…"}
# NEXT_PUBLIC_MARKETPLACE_BY_CHAIN={"31337":"0x…"}
#
# TimelockController — ONLY when deployed (localhost 31337 / future mainnet governance).
# Do NOT set on Base Sepolia testnet: upgradeAuthority there is the deployer EOA, not a timelock contract.
# See docs/contracts/SPEC.md Part II.4.1 (governance roles)
# NEXT_PUBLIC_TIMELOCK_ADDRESS=
# NEXT_PUBLIC_TIMELOCK_BY_CHAIN={"31337":"0x…"}
# AuctionEscrow — optional override (empty = SEPOLIA_ACTIVE / deployment-addresses.ts).
# See docs/contracts/SPEC.md Part I.9.1
# NEXT_PUBLIC_AUCTION_ESCROW_ADDRESS=
# NEXT_PUBLIC_AUCTION_ESCROW_BY_CHAIN={"31337":"0x…"}

# --- Local Hardhat stack (chain 31337) ---
# Full flow: ./scripts/dev-local.sh  OR  ./scripts/e2e-local.sh
# NEXT_PUBLIC_ENABLE_LOCAL_CHAIN=1
# NEXT_PUBLIC_CHAIN_ID=31337
# NEXT_PUBLIC_RPC_BY_CHAIN={"31337":"http://127.0.0.1:8545","84532":"https://sepolia.base.org"}
# PONDER_ENABLE_LOCAL=1
# PONDER_RPC_URL_31337=http://127.0.0.1:8545
# PONDER_START_BLOCK_31337=0
# After `pnpm deploy:local`, addresses are written to deployments/31337.json (gitignored).
# Export env: eval "$(node --import tsx scripts/lib/print-local-env.ts)"

# --- Ponder indexer ---
# Local dev: http://localhost:42069
# Production: https://ponder.yourdomain.com
PONDER_SQL_API_URL=http://localhost:42069

# --- Docker / VPS (.env on server, never commit) ---
# POSTGRES_PASSWORD=
# DATABASE_URL is set by docker-compose from POSTGRES_PASSWORD; override only if needed.
# DATABASE_URL=postgresql://ponder:PASSWORD@postgres:5432/kargain_ponder
#
# Ponder indexer RPC (84532):
#   Production VPS: https://sepolia.base.org (validated June 2026)
#   Do NOT use bare https://base-sepolia.publicnode.com — archive eth_getLogs returns 403 without a personal token.
#   Optional: PublicNode with token, or Alchemy/QuickNode for heavy backfills.
PONDER_RPC_URL_84532=https://sepolia.base.org
#
# Start block (Ponder 0.16):
#   Backfill after ponder-reindex.sql: indexFromBlock from deployments/84532.json, or a checkpoint block.
#   After sync completes: KEEP the same numeric value — do NOT set latest (changes build_id → MigrationError).
# PONDER_START_BLOCK_84532=<indexFromBlock or checkpoint>
# Per-chain (local Hardhat):
# PONDER_START_BLOCK_31337=0
#
# Diagnostic (read-only — addresses from git after pull):
#   pnpm ponder:config
# Optional Ponder address overrides (debug / pre-commit manifest only):
# PONDER_AUCTION_ESCROW_ADDRESS=
# Legacy global fallback (still supported):
# PONDER_START_BLOCK=latest
# CLOUDFLARE_TUNNEL_TOKEN=
# DATABASE_SCHEMA=kargain
# Remove legacy PONDER_DATABASE_URL from .env if present — Ponder reads DATABASE_URL.
#
# Full reindex after schema change: docs/indexer/OPERATIONS.md
#   ./scripts/ponder-reindex.sh
#   PONDER_RPC_URL_84532=https://sepolia.base.org
#   PONDER_START_BLOCK_84532=<indexFromBlock>
#   docker compose up -d --force-recreate ponder
#   After sync: keep the same numeric start block (do not switch to latest).
