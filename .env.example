# =============================================================================
# Kargain environment variables
#
# Copy to `.env.local` for Next.js (`pnpm dev` / `pnpm build`).
# Hardhat reads `.env` / `.env.local` via hardhat.config.ts (dotenv).
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Public origin of the Next.js app (SIWE domain, metadata, redirects).
# Used by: lib/config/app-url.ts, lib/auth/siwe-session.ts
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional production override for SIWE session signing.
# If unset, a dev fallback derived from NEXT_PUBLIC_APP_URL is used.
# Used by: lib/auth/siwe-session.ts
# SIWE_SESSION_SECRET=

# -----------------------------------------------------------------------------
# Wallet / chains
# -----------------------------------------------------------------------------

# Default chain ID shown in the UI (Base Sepolia = 84532; local Hardhat = 31337).
# Used by: lib/web3/supported-chains.ts
NEXT_PUBLIC_CHAIN_ID=84532

# Set to 1 to expose Hardhat localhost (31337) in wagmi chain list.
# Used by: lib/web3/supported-chains.ts
# NEXT_PUBLIC_ENABLE_LOCAL_CHAIN=1

# JSON map of chain ID → public RPC URL for wagmi/viem reads.
# Example: {"84532":"https://sepolia.base.org","31337":"http://127.0.0.1:8545"}
# Used by: lib/web3/supported-chains.ts
NEXT_PUBLIC_RPC_BY_CHAIN={"84532":"https://sepolia.base.org"}

# Per-chain RPC override (alternative to NEXT_PUBLIC_RPC_BY_CHAIN).
# Example: NEXT_PUBLIC_RPC_84532=https://sepolia.base.org
# Used by: lib/web3/supported-chains.ts

# -----------------------------------------------------------------------------
# XMTP (encrypted messaging)
# -----------------------------------------------------------------------------

# XMTP environment: dev | production | testnet | mainnet
# See https://docs.xmtp.org
# Used by: lib/xmtp/client.ts
NEXT_PUBLIC_XMTP_ENV=dev

# -----------------------------------------------------------------------------
# Storage (Arweave / IPFS)
# -----------------------------------------------------------------------------

# HTTP gateway for resolving ipfs:// URIs in legacy metadata.
# Used by: lib/storage/resolve-uri.ts
IPFS_GATEWAY_URL=https://ipfs.io/ipfs

# -----------------------------------------------------------------------------
# Hardhat (compile, test, future deploy)
# -----------------------------------------------------------------------------

# Base Sepolia RPC for the hardhat `baseSepolia` network.
# Used by: hardhat.config.ts
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer wallet private key for Hardhat networks (never commit a real key).
# Used by: hardhat.config.ts (baseSepolia only — localhost uses Hardhat node default accounts)
# DEPLOYER_PRIVATE_KEY=

# Basescan / Etherscan API key for contract verification on Base Sepolia.
# Used by: hardhat.config.ts verify.etherscan, pnpm verify:v1.1
ETHERSCAN_API_KEY=

# --- Deployed contracts (Base Sepolia, chain 84532) ---
# Resolution order: NEXT_PUBLIC_*_BY_CHAIN → single NEXT_PUBLIC_* → deployments/31337.json (local) → hardcoded Sepolia
# Used by: lib/web3/deployment-addresses.ts
NEXT_PUBLIC_KAR_PASSPORT_ADDRESS=
NEXT_PUBLIC_KAR_PRO_PASS_ADDRESS=
NEXT_PUBLIC_KAR_PRO_STAKING_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_NATIVE_FEED_ADDRESS=
NEXT_PUBLIC_EUR_FEED_ADDRESS=
# NEXT_PUBLIC_KAR_PASSPORT_BY_CHAIN={"31337":"0x…","84532":"0x…"}
# NEXT_PUBLIC_MARKETPLACE_BY_CHAIN={"31337":"0x…"}

# --- Local Hardhat stack (chain 31337) ---
# Full flow: ./scripts/dev-local.sh  OR  ./scripts/e2e-local.sh
# NEXT_PUBLIC_ENABLE_LOCAL_CHAIN=1
# NEXT_PUBLIC_CHAIN_ID=31337
# NEXT_PUBLIC_RPC_BY_CHAIN={"31337":"http://127.0.0.1:8545","84532":"https://sepolia.base.org"}
# PONDER_ENABLE_LOCAL=1
# PONDER_RPC_URL_31337=http://127.0.0.1:8545
# PONDER_START_BLOCK_31337=0
# After `pnpm deploy:local`, addresses are written to deployments/31337.json (gitignored).
# Export env: eval "$(node --import tsx scripts/lib/print-local-env.ts)"

# --- Ponder indexer ---
# Local dev: http://localhost:42069
# Production: https://ponder.yourdomain.com
PONDER_SQL_API_URL=http://localhost:42069

# --- Docker / VPS (.env on server, never commit) ---
# POSTGRES_PASSWORD=
# DATABASE_URL is set by docker-compose from POSTGRES_PASSWORD; override only if needed.
# DATABASE_URL=postgresql://ponder:PASSWORD@postgres:5432/kargain_ponder
# Production default: latest — index from restart only; publicnode is fine.
PONDER_RPC_URL_84532=https://base-sepolia.publicnode.com
# Per-chain start blocks (preferred over legacy PONDER_START_BLOCK):
# PONDER_START_BLOCK_84532=latest
# PONDER_START_BLOCK_31337=0
# One-time full backfill after redeploy (from deployments/84532.json indexFromBlock):
#   eval "$(node --import tsx scripts/lib/print-ponder-env.ts)"
#   PONDER_START_BLOCK_84532=<indexFromBlock from manifest>
#   PONDER_RPC_URL_84532=https://base-sepolia.g.alchemy.com/v2/KEY
# Legacy global fallback (still supported):
# PONDER_START_BLOCK=latest
# CLOUDFLARE_TUNNEL_TOKEN=
# DATABASE_SCHEMA=kargain
# Remove legacy PONDER_DATABASE_URL from .env if present — Ponder reads DATABASE_URL.
#
# Full reindex after contract redeploy (see ponder.config.ts + scripts/ponder-reindex.sql):
#   ./scripts/ponder-reindex.sh   # VPS Docker
#   psql "$DATABASE_URL" -f scripts/ponder-reindex.sql   # local
# Then set env from manifest: eval "$(node --import tsx scripts/lib/print-ponder-env.ts)"
# After sync completes, set PONDER_START_BLOCK_84532=latest and restart Ponder.
