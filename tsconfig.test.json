{
  "compilerOptions": {
    "target": "ES2022",
    // Tests import product modules (React, IndexedDB, window, canvas). DOM +
    // jsx match that Program graph — not a silence for tooling-local APIs.
    // Solana paths: test/svm-stand imports stand sources (svm project roots);
    // Program graph needs the same lab resolution as svm/tsconfig.json.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./*"],
      "@solana/web3.js": ["./svm/lab/node_modules/@solana/web3.js"],
      "@solana/web3.js/*": ["./svm/lab/node_modules/@solana/web3.js/*"],
      "@solana/spl-token": ["./svm/lab/node_modules/@solana/spl-token"],
      "@solana/spl-token/*": ["./svm/lab/node_modules/@solana/spl-token/*"],
      "@metaplex-foundation/*": ["./svm/lab/node_modules/@metaplex-foundation/*"]
    }
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "svm",
    "scripts"
  ]
}
