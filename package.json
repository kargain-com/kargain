    "lucide-static": "0.503.0",
    "mono-icons": "1.3.1",
    "ponder": "^0.16.6",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "patchedDependencies": {
      "@layerzerolabs/onft-evm@0.2.4": "patches/@layerzerolabs__onft-evm@0.2.4.patch",
      "@layerzerolabs/oapp-evm@0.4.1": "patches/@layerzerolabs__oapp-evm@0.4.1.patch"
    }
  }
