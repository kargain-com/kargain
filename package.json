{
  "name": "kargain",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kargain-com/kargain"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:metadata": "node --import tsx --test test/passport-metadata.test.ts",
    "test:vin-insight": "node --import tsx --test test/vin-insight.test.ts",
    "test:listing": "node --import tsx --test test/listing-query.test.ts",
    "test:ponder": "node --import tsx --test test/ponder-indexer.test.ts",
    "test:trust": "node --import tsx --test test/trust-signals.test.ts",
    "test:records": "node --import tsx --test test/record-types.test.ts",
    "test:confirm-status": "node --import tsx --test test/confirm-listing-status.test.ts",
    "test:nostr": "node --import tsx --test test/nostr-key-manager.test.ts",
    "test:notifications": "node --import tsx --test test/notification-state.test.ts test/map-nostr-event.test.ts",
    "test:verify": "node --import tsx --test test/verify-constructor-args.test.ts test/verify-failure-class.test.ts",
    "test:e2e": "KARGAIN_E2E_LOCAL=1 node --import tsx --test test/e2e-local.test.ts",
    "deploy:local": "hardhat run scripts/deploy-local.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "deploy:auction": "hardhat run scripts/deploy-auction.ts --network baseSepolia",
    "verify:sepolia": "node --import tsx scripts/verify.ts",
    "smoke:sepolia": "hardhat run scripts/smoke-deploy.ts --network baseSepolia",
    "abis:export": "node scripts/export-abis.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "postcompile": "pnpm abis:export",
    "ponder:config": "node --import tsx scripts/ponder-config.ts",
    "ponder:dev": "ponder dev",
    "ponder:start": "ponder start"
  },
  "dependencies": {
    "@irys/web-upload": "^0.0.15",
