    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.2",
    "@walletconnect/ethereum-provider": "^2.21.1",
    "@xmtp/client": "npm:@xmtp/browser-sdk@7.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ethers": "6",
    "framer-motion": "^12.38.0",
    "geist": "^1.3.1",
    "heic2any": "^0.0.4",
    "light-bolt11-decoder": "^3.2.0",
    "nanoid": "^5.1.7",
    "next": "16.2.0",
    "nostr-tools": "2.23.3",
    "qrcode": "1.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.72.0",
    "siwe": "^3.0.0",
    "tailwind-merge": "^3.2.0",
    "undici": "7.16.0",
    "viem": "2.47.4",
    "wagmi": "^2.19.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@layerzerolabs/lz-evm-protocol-v2": "3.0.148",
    "@layerzerolabs/oapp-evm": "0.4.1",
    "@layerzerolabs/onft-evm": "0.2.4",
    "@nomicfoundation/hardhat-ignition": "^3.1.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.3",
    "@openzeppelin/contracts": "^5.2.0",
    "@openzeppelin/hardhat-upgrades": "^4.0.2",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.14.1",
    "@types/qrcode": "^1.5.5",
